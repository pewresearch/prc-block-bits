{
	"name": "@prc/block-bits",
	"version": "1.0.2",
	"description": "Inline-RichText 'bits' registry, central render-block walker, and editor toolbar for the PRC Platform.",
	"scripts": {
		"build": "wp-scripts build && wp-scripts build --config webpack.settings.config.js",
		"build:settings": "wp-scripts build --config webpack.settings.config.js",
		"start": "wp-scripts start",
		"start:settings": "wp-scripts start --config webpack.settings.config.js",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@wordpress/scripts": "^31.4.0"
	},
	"dependencies": {
		"@prc/components": "*",
		"@prc/hooks": "*",
		"@prc/icons": "*",
		"@wordpress/icons": "^10.21.0"
	},
	"license": "GPL-2.0-or-later"
}
